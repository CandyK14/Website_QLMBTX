@model IEnumerable<QLMuaBanTuiXach.Models.PhieuNhap>

@{
    ViewBag.Title = "Quản Lý Kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 text-primary fw-bold"><i class="fa-solid fa-warehouse me-2"></i>DANH SÁCH PHIẾU NHẬP KHO</h5>
        <a href="@Url.Action("Create")" class="btn btn-success">
            <i class="fa-solid fa-plus me-1"></i> Nhập Hàng Mới
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">Số Phiếu</th>
                        <th>Ngày Nhập</th>
                        <th>Nhà Cung Cấp</th>
                        <th>Người Nhập</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@item.SoPhieu</td>
                            <td>@item.NgayNhap.Value.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.NhaCungCap != null ? item.NhaCungCap.TenNhaCungCap : "---")</td>
                            <td>@(item.NguoiDung != null ? item.NguoiDung.HoTen : "N/A")</td>
                            <td class="fw-bold text-danger">@((item.TongTien ?? 0).ToString("N0")) ₫</td>
                            <td>
                                @if (item.TrangThai == "DaDuyet")
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Đã Duyệt</span>
                                }
                                else if (item.TrangThai == "TuChoi")
                                {
                                    <span class="badge bg-danger">Từ Chối</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-start me-1"></i>Chờ Duyệt</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a href="@Url.Action("Details", new { id = item.MaPhieuNhap })" class="btn btn-sm btn-outline-info">
                                    <i class="fa-solid fa-circle-info"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>