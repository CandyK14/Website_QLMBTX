@model QLMuaBanTuiXach.Models.YeuCauThemSanPham

@{
    ViewBag.Title = "Yêu Cầu Nhập Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow-sm" style="max-width: 900px; margin: 20px auto;">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="fa-solid fa-file-signature me-2"></i>PHIẾU YÊU CẦU TẠO MÃ HÀNG</h4>
    </div>
    <div class="card-body">

        @using (Html.BeginForm("TaoYeuCau", "AdminKho", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger" })

            <div class="alert alert-info small">
                Hãy chọn loại yêu cầu: Bạn muốn tạo <strong>Sản Phẩm Mới Hoàn Toàn</strong> hay chỉ thêm <strong>Màu Mới</strong> cho sản phẩm đã có?
            </div>

            @* PHẦN 1: CHỌN LOẠI YÊU CẦU *@
            <div class="row mb-4 border p-3 rounded bg-light mx-1">
                <div class="col-md-6 border-end">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="loaiYeuCau" id="optMoi" value="Moi" checked>
                        <label class="form-check-label fw-bold text-primary" for="optMoi">
                            <i class="fa-solid fa-star"></i> SẢN PHẨM MỚI HOÀN TOÀN
                        </label>
                    </div>
                    <div class="mt-3 ps-4">
                        <label class="small text-muted">Tên Sản Phẩm Mới:</label>
                        <input type="text" name="tenSanPhamMoi" class="form-control mb-2" placeholder="VD: Túi Chanel Boy 2025...">

                        <label class="small text-muted">Thương Hiệu:</label>
                        <input type="text" name="thuongHieu" class="form-control mb-2" placeholder="VD: Chanel">

                        <label class="small text-muted">Danh Mục:</label>
                        <input type="text" name="danhMuc" class="form-control" placeholder="VD: Túi Đeo Chéo">
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="loaiYeuCau" id="optCu" value="Cu">
                        <label class="form-check-label fw-bold text-success" for="optCu">
                            <i class="fa-solid fa-plus-circle"></i> THÊM BIẾN THỂ (MÀU/SIZE) CHO SP CŨ
                        </label>
                    </div>
                    <div class="mt-3 ps-4">
                        <label class="small text-muted">Chọn Sản Phẩm Đã Có:</label>
                        @Html.DropDownList("tenSanPhamCu", ViewBag.ListSanPhamCu as SelectList, "-- Chọn sản phẩm gốc --", new { @class = "form-select" })
                        <div class="form-text text-muted">Chỉ chọn bên này nếu sản phẩm đã có trong hệ thống.</div>
                    </div>
                </div>
            </div>

            @* PHẦN 2: CHI TIẾT BIẾN THỂ (CHUNG CHO CẢ 2) *@
            <h5 class="text-secondary border-bottom pb-2 mb-3">Thông Tin Chi Tiết Nhập Hàng</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="fw-bold">Màu Sắc <span class="text-danger">*</span></label>
                    <input type="text" name="mauSac" class="form-control" required placeholder="VD: Xanh Rêu">
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Kích Thước</label>
                    <input type="text" name="kichThuoc" class="form-control" placeholder="VD: 25x15 cm">
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Giá Nhập Dự Kiến</label>
                    <input type="number" name="giaNhap" class="form-control" placeholder="VNĐ">
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Số Lượng Cần Nhập</label>
                    <input type="number" name="soLuong" class="form-control" placeholder="Cái">
                </div>
                <div class="col-12">
                    <label class="fw-bold">Ghi Chú Khác</label>
                    <textarea name="ghiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            <div class="text-end">
                <a href="@Url.Action("Create")" class="btn btn-secondary me-2">Quay Lại</a>
                <button type="submit" class="btn btn-warning fw-bold px-5">
                    <i class="fa-solid fa-paper-plane"></i> GỬI YÊU CẦU
                </button>
            </div>
        }
    </div>
</div>