@using QLMuaBanTuiXach.Models
@model List<GioHang>
@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var user = ViewBag.NguoiDung as NguoiDung;
    decimal tongTienHang = ViewBag.TongTienHang;
    decimal ship = ViewBag.PhiVanChuyen;
    decimal tongCong = tongTienHang + ship;
}

<main>
    <div class="container" style="margin-top: 40px; margin-bottom: 50px;">
        <h2>Thanh Toán Đơn Hàng</h2>

        @using (Html.BeginForm("DatHang", "GioHang", FormMethod.Post, new { @class = "checkout-form" }))
        {
            <div class="checkout-layout">

                <div class="checkout-info">
                    <h3>Thông tin giao hàng</h3>

                    <div class="form-group">
                        <label>Họ tên người nhận</label>
                        <input type="text" name="tenNguoiNhan" value="@user.HoTen" required class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <input type="text" name="soDienThoai" value="@user.SoDienThoai" required class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ (Số nhà, đường)</label>
                        <input type="text" name="diaChi" required class="form-control" placeholder="Ví dụ: 123 Nguyễn Huệ" />
                    </div>

                    <div class="form-row">
                        <div class="form-group half">
                            <label>Tỉnh / Thành phố</label>
                            <input type="text" name="tinhThanh" required class="form-control" />
                        </div>
                        <div class="form-group half">
                            <label>Quận / Huyện</label>
                            <input type="text" name="quanHuyen" required class="form-control" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Phường / Xã</label>
                        <input type="text" name="phuongXa" required class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Ghi chú đơn hàng (Tùy chọn)</label>
                        <textarea name="ghiChu" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="checkout-summary">
                    <h3>Đơn hàng của bạn</h3>

                    <div class="order-items-list">
                        @foreach (var item in Model)
                        {
                            <div class="order-item">
                                <span class="item-name">
                                    @item.BienTheSanPham.SanPham.TenSanPham
                                    <small>(@item.BienTheSanPham.MauSac) x @item.SoLuong</small>
                                </span>
                                <span class="item-price">
                                    @((item.SoLuong * item.BienTheSanPham.GiaBan).ToString("N0")) ₫
                                </span>
                            </div>
                        }
                    </div>

                    <div class="order-total-box">
                        <div class="row-summary">
                            <span>Tạm tính</span>
                            <span>@tongTienHang.ToString("N0") ₫</span>
                        </div>
                        <div class="row-summary">
                            <span>Phí vận chuyển</span>
                            <span>@ship.ToString("N0") ₫</span>
                        </div>
                        <div class="row-summary total">
                            <span>Tổng cộng</span>
                            <span style="color: #B22222;">@tongCong.ToString("N0") ₫</span>
                        </div>

                        <div class="payment-method">
                            <label><input type="radio" name="payment" checked /> Thanh toán khi nhận hàng (COD)</label>
                        </div>

                        <button type="submit" class="btn-place-order">ĐẶT HÀNG</button>
                    </div>
                </div>
            </div>
        }
    </div>
</main>

<style>
    .checkout-layout {
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
    }

    .checkout-info {
        flex: 1.5;
    }

    .checkout-summary {
        flex: 1;
    }

    .checkout-summary {
        background: #f9f9f9;
        padding: 25px;
        border-radius: 8px;
        border: 1px solid #eee;
        height: fit-content;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 14px;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
    }

    .form-row {
        display: flex;
        gap: 15px;
    }

    .form-group.half {
        flex: 1;
    }

    .order-items-list {
        max-height: 200px;
        overflow-y: auto;
        border-bottom: 1px dashed #ddd;
        margin-bottom: 15px;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .item-name small {
        display: block;
        color: #777;
    }

    .row-summary {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        color: #555;
    }

        .row-summary.total {
            font-size: 20px;
            font-weight: bold;
            color: #333;
            border-top: 2px solid #ddd;
            padding-top: 15px;
            margin-top: 15px;
        }

    .payment-method {
        margin: 20px 0;
        padding: 10px;
        background: white;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    .btn-place-order {
        width: 100%;
        padding: 15px;
        background: #B22222;
        color: white;
        border: none;
        font-weight: bold;
        font-size: 16px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-place-order:hover {
            background: #8b0000;
        }
</style>