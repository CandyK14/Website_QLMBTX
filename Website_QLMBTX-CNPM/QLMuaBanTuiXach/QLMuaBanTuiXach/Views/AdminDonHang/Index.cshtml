@model IEnumerable<QLMuaBanTuiXach.Models.DonHang>

@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 text-primary fw-bold"><i class="fa-solid fa-receipt me-2"></i>DANH SÁCH ĐƠN HÀNG</h5>
        @* Có thể thêm bộ lọc ở đây sau này *@
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="bg-light text-dark">
                    <tr>
                        <th class="py-3 ps-3">Mã ĐH</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Thanh Toán</th>
                        <th>TT Thanh Toán</th>
                        <th>Trạng Thái Đơn</th>
                        <th class="text-end pe-3">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@item.MaDonHang</td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="fw-bold">@(item.NguoiDung != null ? item.NguoiDung.HoTen : "Khách vãng lai")</span>
                                    <small class="text-muted">@(item.NguoiDung != null ? item.NguoiDung.SoDienThoai : "")</small>
                                </div>
                            </td>
                            <td>@item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@item.TongThanhToan.ToString("N0") ₫</td>

                            @* Xử lý hiển thị Trạng thái thanh toán *@
                            <td>
                                @if (item.TrangThaiThanhToan == "DaThanhToan")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill border border-success">
                                        <i class="fa-solid fa-check-circle me-1"></i>Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 rounded-pill border border-warning">
                                        <i class="fa-solid fa-clock me-1"></i>Chưa thanh toán
                                    </span>
                                }
                            </td>

                            @* Xử lý hiển thị Trạng thái đơn hàng *@
                            <td>
                                @{
                                    string badgeClass = "bg-secondary";
                                    string icon = "fa-minus";
                                    switch (item.TrangThai)
                                    {
                                        case "ChoXuLy": badgeClass = "bg-warning text-dark"; icon = "fa-hourglass-start"; break;
                                        case "DangXuLy": badgeClass = "bg-info text-dark"; icon = "fa-gear fa-spin"; break;
                                        case "DangGiao": badgeClass = "bg-primary"; icon = "fa-truck"; break;
                                        case "DaGiao": badgeClass = "bg-success"; icon = "fa-check"; break;
                                        case "DaHuy": badgeClass = "bg-danger"; icon = "fa-times"; break;
                                        case "DoiTra": badgeClass = "bg-dark"; icon = "fa-rotate-left"; break;
                                    }
                                }
                                <span class="badge @badgeClass">
                                    <i class="fa-solid @icon me-1"></i> @item.TrangThai
                                </span>
                            </td>

                            <td class="text-end pe-3">
                                <a href="@Url.Action("Details", new { id = item.MaDonHang })" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.MaDonHang })" class="btn btn-sm btn-outline-warning ms-1" title="Cập nhật trạng thái">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-light">
        <small class="text-muted">Tổng số đơn hàng: <strong>@Model.Count()</strong></small>
    </div>
</div>