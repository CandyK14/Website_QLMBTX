@model QLMuaBanTuiXach.Models.DanhMuc

@{
    ViewBag.Title = "Thêm Danh Mục Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow-sm" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">THÊM DANH MỤC</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên Danh Mục</label>
                    @Html.EditorFor(model => model.TenDanhMuc, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.TenDanhMuc, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Danh Mục Cha (Nếu có)</label>
                    @Html.DropDownList("MaDanhMucCha", null, "-- Là Danh Mục Gốc --", htmlAttributes: new { @class = "form-select" })
                    <small class="text-muted">Để trống nếu đây là danh mục lớn (VD: Túi Xách).</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mô Tả</label>
                    @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control", rows = 3 })
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-success">Lưu Danh Mục</button>
                </div>
            </div>
        }
    </div>
</div>