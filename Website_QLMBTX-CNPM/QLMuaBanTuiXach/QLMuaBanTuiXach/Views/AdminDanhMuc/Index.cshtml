@model IEnumerable<QLMuaBanTuiXach.Models.DanhMuc>

@{
    ViewBag.Title = "Quản Lý Danh Mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-uppercase fw-bold text-success">DANH SÁCH DANH MỤC</h3>
    <a href="@Url.Action("Create")" class="btn btn-success shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> Thêm Danh Mục
    </a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i> @TempData["ThongBao"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Loi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Tên Danh Mục</th>
                    <th>Mô Tả</th>
                    <th style="width: 150px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.MaDanhMuc</td>
                            <td class="fw-bold">@item.TenDanhMuc</td>
                            <td>@item.MoTa</td>
                            <td class="text-center">
                                <a href="@Url.Action("Edit", new { id = item.MaDanhMuc })" class="btn btn-warning btn-sm" title="Sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.MaDanhMuc })" class="btn btn-danger btn-sm ms-1" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>