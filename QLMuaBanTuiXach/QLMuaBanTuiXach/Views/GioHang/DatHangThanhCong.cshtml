@model int
@{
    ViewBag.Title = "Đặt Hàng Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="text-align: center; padding: 80px 0;">
    <div style="font-size: 60px; color: #28a745; margin-bottom: 20px;">
        <i class="fa-solid fa-circle-check"></i>
    </div>
    <h1 style="margin-bottom: 10px;">Đặt Hàng Thành Công!</h1>
    <p style="font-size: 18px; color: #555;">Cảm ơn bạn đã mua sắm. Mã đơn hàng của bạn là: <strong>#@Model</strong></p>
    <p>Chúng tôi sẽ sớm liên hệ để giao hàng cho bạn.</p>

    <div style="margin-top: 30px;">
        <a href="@Url.Action("Index", "Home")" class="btn" style="background: #333; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;">Tiếp tục mua sắm</a>
    </div>
</div>