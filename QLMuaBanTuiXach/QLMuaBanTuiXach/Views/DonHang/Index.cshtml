@model List<QLMuaBanTuiXach.Models.DonHang>
@{
    ViewBag.Title = "Lịch Sử Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 40px; margin-bottom: 50px;">
    <h2>Lịch sử mua hàng</h2>

    @if (Model.Count > 0)
    {
        <table class="table table-bordered table-hover" style="margin-top: 20px;">
            <thead style="background-color: #f8f9fa;">
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.MaDonHang</td>
                        <td>@item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="color:#B22222; font-weight:bold;">@item.TongThanhToan.ToString("N0") ₫</td>
                        <td>
                            @if (item.TrangThai == "ChoXuLy")
                            {<span class="badge badge-warning" style="background:orange; color:white; padding:5px;">Chờ xử lý</span> }
                            else if (item.TrangThai == "DaGiao")
                            { <span class="badge badge-success" style="background:green; color:white; padding:5px;">Đã giao</span> }
                            else
                            { <span>@item.TrangThai</span>}
                        </td>
                        <td>
                            <a href="@Url.Action("ChiTiet", "DonHang", new { id = item.MaDonHang })" class="btn btn-sm btn-info">Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Bạn chưa có đơn hàng nào.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-dark">Đi mua sắm ngay</a>
    }
</div>